# ==============================================================================
# SV STOCK RESEARCH CRM - BACKEND API ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
ADMIN_APP_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection
# Neon Serverless PostgreSQL:
# 1. DATABASE_URL: Pooled connection string (with '-pooler') for NestJS runtime queries
DATABASE_URL=postgresql://neondb_owner:[YOUR_PASSWORD]@[YOUR_ENDPOINT]-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 2. DIRECT_URL: Direct unpooled connection string (without '-pooler') for Prisma schema migrations
DIRECT_URL=postgresql://neondb_owner:[YOUR_PASSWORD]@[YOUR_ENDPOINT].ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Alternatively, for local Docker or Render PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sv_stock_crm?schema=public
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/sv_stock_crm?schema=public

# Security & Authentication Secrets
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace_with_a_secure_random_64_char_hex_secret
SESSION_SECRET=replace_with_another_secure_random_64_char_hex_secret
JWT_EXPIRES_IN=8h

# WordPress Integration Credentials & Secrets
WP_SITE_URL=https://svstockresearch.in
WP_SITE_IDENTIFIER=sv-stock-research-main

# HMAC-SHA256 Webhook Verification Secret (WordPress -> Render)
WP_WEBHOOK_SECRET=replace_with_shared_webhook_secret_from_wp_config

# HMAC-SHA256 Historical Entry Pull Secret (Render -> WordPress)
WP_PULL_SECRET=replace_with_shared_pull_secret_from_wp_config

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
