{
  "name": "sv-stock-research-admin",
  "version": "1.0.0",
  "private": true,
  "description": "SV Stock Research - Enterprise Lead CRM & WPForms Management System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@sv-crm/shared",
    "build:api": "npm run build --workspace=@sv-crm/api",
    "build:admin": "npm run build --workspace=@sv-crm/admin",
    "dev:api": "npm run start:dev --workspace=@sv-crm/api",
    "dev:admin": "npm run dev --workspace=@sv-crm/admin",
    "dev": "npm run dev:admin",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=@sv-crm/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@sv-crm/api",
    "provision:admin": "npm run provision:admin --workspace=@sv-crm/api"
  },
  "keywords": [
    "crm",
    "lead-management",
    "wpforms",
    "nestjs",
    "nextjs",
    "postgresql",
    "prisma"
  ],
  "author": "SV Stock Research",
  "license": "UNLICENSED"
}
